# Пример переменных окружения для vibe-order-infra.
# Скопируйте этот файл в .env для локальной/серверной среды:
#   cp .env.example .env
#
# Все значения ниже — безопасные плейсхолдеры. Реальные пароли
# генерируйте самостоятельно (например: openssl rand -base64 32)
# и никогда не коммитьте .env в git.
#
# docker-compose.yml требует эти переменные через ${VAR:?...} —
# без .env со ВСЕМИ значениями ниже `docker compose config`/`up`
# откажется стартовать с явной ошибкой (а не тихо подставит пустую
# строку). Проверить: docker compose --env-file .env.example config

# ==== PostgreSQL — кластерный bootstrap/admin-креденшл (обязательны) ====
# Это ТОЛЬКО суперпользователь, которого сам официальный образ postgres
# создаёт при первой инициализации кластера (см. сервис postgres в
# docker-compose.yml). Начиная со Stage 2 он НЕ используется ни backend'ом,
# ни Alembic напрямую — только одноразовыми сервисами db-roles-bootstrap/
# db-roles-finalize (см. app/db_admin/bootstrap_roles.py) для создания и
# настройки прав MIGRATION_DB_*/APP_DB_* ролей ниже, и вручную —
# app/db_admin/adopt_legacy.py при переносе продакшн-базы (см. README /
# backend/app/db_admin/adopt_legacy.py).
POSTGRES_USER=vibe_admin
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=vibe_orders

# ==== PostgreSQL — миграционная/владеющая роль (обязательны) ====
# Единственная роль, от имени которой когда-либо подключается Alembic (см.
# backend/alembic/env.py и сервис db-migrate в docker-compose.yml). Не
# суперпользователь: получает только CREATE/USAGE на схему public (см.
# app/db_admin/bootstrap_roles.py) — ровно то, что нужно `alembic upgrade
# head`, не больше.
MIGRATION_DB_USER=vibe_migrator
MIGRATION_DB_PASSWORD=change_me_strong_password

# ==== PostgreSQL — runtime-роль backend'а (обязательны) ====
# Единственная роль, от имени которой backend подключается к БД в обычной
# работе (см. app/core/config.py). Не имеет прав DDL (CREATE/ALTER/DROP
# TABLE и т.п.) и не имеет доступа к alembic_version — только
# SELECT/INSERT/UPDATE/DELETE на таблицы приложения и
# USAGE/SELECT/UPDATE на их sequences (см. app/db_admin/bootstrap_roles.py и
# backend/tests/test_db_role_privileges.py).
APP_DB_USER=vibe_app
APP_DB_PASSWORD=change_me_strong_password

# ==== pgAdmin (обязательны, только если используется профиль "admin") ====
# Учётные данные для входа в веб-интерфейс pgAdmin.
# pgAdmin запускается только по профилю "admin" и доступен исключительно
# через 127.0.0.1 (см. README про SSH-туннель).
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me_strong_password

# ==== Docker Registry ====
# Учётные данные пользователей Registry НЕ хранятся здесь и не хранятся
# в репозитории: они создаются на VPS через registry/create-user.sh
# ДО первого запуска Registry и попадают в registry/auth/htpasswd
# (файл исключён из git). REGISTRY_AUTH_HTPASSWD_REALM/PATH заданы
# как внутренние константы прямо в docker-compose.yml, .env для них
# не используется.

# ==== Watchtower (необязательна, есть безопасное значение по умолчанию) ====
# Интервал опроса образов на предмет обновлений, в секундах.
# 86400 = раз в сутки. На данном этапе Watchtower не обновляет НИ ОДИН
# контейнер автоматически: label com.centurylinklabs.watchtower.enable
# выставлен в "false" у nginx/postgres/pgadmin/registry (см. README,
# раздел "Watchtower"). Переменная всё равно задокументирована здесь
# на будущее, когда opt-in будет включаться точечно (например, для
# backend).
WATCHTOWER_POLL_INTERVAL=86400

# ==== Домены ====
# Используются для документации и будущей автоматизации выпуска TLS
# (certbot и т.п.); в текущей bootstrap-конфигурации Nginx прописаны
# статически в nginx/conf.d/*.conf.
DOMAIN_MAIN=vibe.elivcloud.org
DOMAIN_REGISTRY=registry-vibe.elivcloud.org

# ==== Backend Auth (JWT), обязательны ====
# Сгенерировать локально, любой вариант:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#   openssl rand -hex 32
# НЕ коммитить реальное значение. Минимум 32 символа; плейсхолдер ниже
# намеренно отклоняется валидацией Settings (app/core/config.py), если его
# забыли заменить, — отсутствующий или небезопасный секрет не должен
# незаметно пройти в конфигурацию. docker-compose.yml требует JWT_SECRET_KEY
# через ${VAR:?...} без fallback (см. комментарий у backend в
# docker-compose.yml); JWT_ALGORITHM/ACCESS_TOKEN_EXPIRE_MINUTES ниже —
# несекретные значения с безопасными defaults, совпадающими с Settings.
JWT_SECRET_KEY=change_me_to_a_random_64_char_secret_generated_locally_1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
