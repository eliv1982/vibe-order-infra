# Пример переменных окружения для vibe-order-infra.
# Скопируйте этот файл в .env для локальной/серверной среды:
#   cp .env.example .env
#
# Все значения ниже — безопасные плейсхолдеры. Реальные пароли
# генерируйте самостоятельно (например: openssl rand -base64 32)
# и никогда не коммитьте .env в git.
#
# docker-compose.yml требует эти переменные через ${VAR:?...} —
# без .env со ВСЕМИ значениями ниже `docker compose config`/`up`
# откажется стартовать с явной ошибкой (а не тихо подставит пустую
# строку). Проверить: docker compose --env-file .env.example config

# ==== PostgreSQL (обязательны) ====
# Используется контейнером postgres и (опционально) pgadmin/backend
# для подключения к БД по внутренней Docker-сети app-net.
POSTGRES_USER=vibe_app
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=vibe_orders

# ==== pgAdmin (обязательны, только если используется профиль "admin") ====
# Учётные данные для входа в веб-интерфейс pgAdmin.
# pgAdmin запускается только по профилю "admin" и доступен исключительно
# через 127.0.0.1 (см. README про SSH-туннель).
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me_strong_password

# ==== Docker Registry ====
# Учётные данные пользователей Registry НЕ хранятся здесь и не хранятся
# в репозитории: они создаются на VPS через registry/create-user.sh
# ДО первого запуска Registry и попадают в registry/auth/htpasswd
# (файл исключён из git). REGISTRY_AUTH_HTPASSWD_REALM/PATH заданы
# как внутренние константы прямо в docker-compose.yml, .env для них
# не используется.

# ==== Watchtower (необязательна, есть безопасное значение по умолчанию) ====
# Интервал опроса образов на предмет обновлений, в секундах.
# 86400 = раз в сутки. На данном этапе Watchtower не обновляет НИ ОДИН
# контейнер автоматически: label com.centurylinklabs.watchtower.enable
# выставлен в "false" у nginx/postgres/pgadmin/registry (см. README,
# раздел "Watchtower"). Переменная всё равно задокументирована здесь
# на будущее, когда opt-in будет включаться точечно (например, для
# backend).
WATCHTOWER_POLL_INTERVAL=86400

# ==== Домены ====
# Используются для документации и будущей автоматизации выпуска TLS
# (certbot и т.п.); в текущей bootstrap-конфигурации Nginx прописаны
# статически в nginx/conf.d/*.conf.
DOMAIN_MAIN=vibe.elivcloud.org
DOMAIN_REGISTRY=registry-vibe.elivcloud.org
